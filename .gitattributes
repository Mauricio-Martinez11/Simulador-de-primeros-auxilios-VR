# Normalizar los archivos de texto y mantener intactos los binarios.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf

# Los modelos grandes se almacenan mediante Git LFS, incluidos .Fbx y .FBX.
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
